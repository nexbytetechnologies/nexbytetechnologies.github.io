---
const currentYear = new Date().getFullYear();

const baseURL = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer
  class="border-t border-[#D3C5B2] bg-[#E7DAC6] transition-colors dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto max-w-7xl px-6 py-10">
    <div
      class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <a href="#inicio" class="flex items-center gap-3">
          <img
            src={`${baseURL}nexbyte-icon.webp`}
            alt=""
            class="h-12 w-12 shrink-0 object-contain"
          />

          <div class="w-37.5 leading-none">
            <div
              class="flex justify-between text-lg font-extrabold text-blue-600 dark:text-blue-400"
            >
              <span>N</span>
              <span>E</span>
              <span>X</span>
              <span>B</span>
              <span>Y</span>
              <span>T</span>
              <span>E</span>
            </div>

            <div
              class="mt-1 flex justify-between text-[9px] font-medium text-[#5B6474] dark:text-slate-400"
            >
              <span>T</span>
              <span>E</span>
              <span>C</span>
              <span>H</span>
              <span>N</span>
              <span>O</span>
              <span>L</span>
              <span>O</span>
              <span>G</span>
              <span>I</span>
              <span>E</span>
              <span>S</span>
            </div>
          </div>
        </a>

        <p class="mt-3 text-sm text-[#4B5563] dark:text-slate-400">
          Soluciones digitales para PYMEs.
        </p>
      </div>

      <nav
        class="flex flex-wrap gap-6 text-sm text-[#5B6474] dark:text-slate-400"
      >
        <a
          href="#servicios"
          class="transition hover:text-blue-600 dark:hover:text-white"
        >
          Servicios
        </a>

        <a
          href="#proyectos"
          class="transition hover:text-blue-600 dark:hover:text-white"
        >
          Proyectos
        </a>

        <a
          href="#nosotros"
          class="transition hover:text-blue-600 dark:hover:text-white"
        >
          Nosotros
        </a>

        <a
          href="#contacto"
          class="transition hover:text-blue-600 dark:hover:text-white"
        >
          Contacto
        </a>
      </nav>
    </div>

    <div
     class="mt-10 border-t border-[#D3C5B2] pt-6 text-sm text-[#5B6474] dark:border-slate-800 dark:text-slate-400"
    >
      © {currentYear} Nexbyte Technologies. Todos los derechos reservados.
    </div>
  </div>
</footer>
