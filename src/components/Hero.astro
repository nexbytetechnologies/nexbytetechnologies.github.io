<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden bg-linear-to-br from-[#EDE2D0]
via-[#F4EBDD]
to-[#E6EAF4] pt-28 transition-colors dark:from-slate-950 dark:via-slate-950 dark:to-slate-900"
>

  <!-- Resplandor azul -->
