          Ver proyectos
        </a>

        <a
          href="#contacto"
          class="rounded-xl border border-[#D4CCC0] bg-[#FFFDF8]/70 px-6 py-3 font-semibold text-[#172033] transition hover:border-blue-400 hover:bg-white dark:border-slate-700 dark:bg-transparent dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-slate-900"
        >
          Contactar
        </a>

      </div>
    </div>

    <!-- Panel derecho -->
    <div class="relative hidden lg:block">

      <div
