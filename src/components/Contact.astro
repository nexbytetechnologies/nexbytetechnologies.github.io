<section
  id="contacto"
  class="bg-linear-to-br from-[#EDE2D0] via-[#F4EBDD] to-[#E3EAF5] py-24 transition-colors dark:from-slate-950 dark:via-slate-950 dark:to-slate-900"
>
  <div class="mx-auto max-w-7xl px-6">
    <div
      class="overflow-hidden rounded-3xl border border-[#D3C5B2] bg-[#F8F1E7] shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="grid lg:grid-cols-2">
        <!-- Columna izquierda -->
        <div class="p-8 md:p-12">
          <p
            class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400"
          >
            Contacto
          </p>

          <h2 class="mt-4 text-4xl font-bold text-[#172033] dark:text-white">
            ¿Tienes una idea o proyecto?
          </h2>

          <p class="mt-6 max-w-lg leading-7 text-[#5B6474] dark:text-slate-400">
            Cuéntanos qué necesita tu PYME y conversemos sobre cómo podemos
            transformar esa idea en una solución digital.
          </p>

          <div
            class="mt-10 space-y-4 text-sm text-[#465064] dark:text-slate-300"
          >
            <p>✓ Sitios web y landing pages</p>
            <p>✓ Presencia digital para PYMEs</p>
            <p>✓ Optimización y mejoras web</p>
            <p>✓ Soluciones digitales personalizadas</p>
          </div>

          <!-- WhatsApp preparado para el futuro -->
          <div class="mt-8">
            <button
              type="button"
              disabled
              class="w-full cursor-not-allowed rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white opacity-75 shadow-lg shadow-blue-600/20"
            >
              Enviar consulta — Próximamente
            </button>
          </div>
        </div>

        <!-- Columna derecha -->
        <div
          class="border-t border-[#D3C5B2] bg-[#EFE4D3] p-8 md:p-12 lg:border-l lg:border-t-0 dark:border-slate-800 dark:bg-slate-950/50"
        >
          <form
            action="https://formspree.io/f/mgawrrpr"
            method="POST"
            class="space-y-5"
          >
            <div>
              <label
                for="name"
                class="mb-2 block text-sm text-[#465064] dark:text-slate-300"
              >
                Nombre
              </label>

              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full rounded-xl border border-[#D3C5B2] bg-[#FFFDF8] px-4 py-3 text-[#172033] outline-none transition placeholder:text-[#9B9387] focus:border-blue-500 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-600"
              />
            </div>

            <div>
              <label
                for="email"
                class="mb-2 block text-sm text-[#465064] dark:text-slate-300"
              >
                Correo
              </label>

              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="nombre@correo.cl"
                class="w-full rounded-xl border border-[#D3C5B2] bg-[#FFFDF8] px-4 py-3 text-[#172033] outline-none transition placeholder:text-[#9B9387] focus:border-blue-500 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-600"
              />
            </div>

            <div>
              <label
                for="message"
                class="mb-2 block text-sm text-[#465064] dark:text-slate-300"
              >
                Cuéntanos sobre tu proyecto
              </label>

              <textarea
                id="message"
                name="message"
                rows="5"
                required
                minlength="10"
                placeholder="Necesito un sitio web para..."
                class="w-full resize-none rounded-xl border border-[#D3C5B2] bg-[#FFFDF8] px-4 py-3 text-[#172033] outline-none transition placeholder:text-[#9B9387] focus:border-blue-500 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-600"
              ></textarea>
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="company-website">No completar este campo</label>
              <input
                id="company-website"
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button
              type="submit"
              class="w-full rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-500"
            >
              Enviar consulta
            </button>

            <p class="text-xs text-[#7C7469] dark:text-slate-600">
              Formulario demostrativo. La integración de contacto se añadirá
              posteriormente.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
